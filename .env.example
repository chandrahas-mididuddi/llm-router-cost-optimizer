# Backend: "mock" (offline, default) or "openai" (OpenAI-compatible API)
ROUTER_BACKEND=mock
# OPENAI_API_KEY=<your-key-here>
# OPENAI_BASE_URL=https://api.openai.com/v1
# Path to the routing/model config (defaults to config/routing.yaml)
# ROUTER_CONFIG=config/routing.yaml
# SQLite cost log (defaults to data/costs.db)
# COST_DB=data/costs.db
